{
  "name": "deepseek-mobile-api",
  "version": "1.1.2",
  "description": "基于 DeepSeek 官方网页版与官方 API 的移动端聊天应用（Android + PWA）。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts scripts tests",
    "format": "oxfmt --write .",
    "android:assets": "capacitor-assets generate --android && node scripts/patch-adaptive-icon.mjs",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node scripts/android-build.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:pwa": "node tests/pwa-offline.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "playwright-core": "^1.65.1",
    "typescript": "7.0.2"
  }
}
